node_modules
dist
.env
.env.local
README.local.md
*.webp
*.jpg
*.png
*.nginx
!nginx.nginx

# Runtime data & uploads — must NEVER be in git, otherwise `git reset --hard`
# on deploy overwrites live data (messages, accounts, etc.) with stale commits.
server/data/*.json
server/data/*.sqlite*
server/uploads/*
!server/uploads/.gitkeep