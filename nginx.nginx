map $http_user_agent $blocked_bot {
    default 0;
    ~*Dataprovider 1;
}

server {
    listen 80;
    server_name kevinphan.me www.kevinphan.me;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name kevinphan.me www.kevinphan.me;

    ssl_certificate /etc/pki/tls/certs/kevinphan.me.pem;
    ssl_certificate_key /etc/pki/tls/private/kevinphan.me.key;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 15M;

    if ($blocked_bot) {
        return 403;
    }

    root /home/opc/projects/dotme/dist;
    index index.html;

    # Vite filenames contain content hashes, so these assets can be cached until their URL changes.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Fonts and the portrait use stable filenames, so keep a shorter cache lifetime for safe updates.
    location ^~ /fonts/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000" always;
    }

    location ~* ^/avatar(-[0-9]+)?\.webp$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=2592000" always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
